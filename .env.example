# QMatus Team Tracker — environment variables.
# Copy to .env.local and fill in. Never commit real values.
# For local development, `npm run db:env` writes these from the local Supabase stack.

# Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable key (sb_publishable_...). Safe to expose; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Supabase secret key (sb_secret_...). SERVER-ONLY. Bypasses RLS.
# Used solely by src/server/privileged/* (invitation account creation, session revocation).
# Never prefix with NEXT_PUBLIC_ and never import it from client code.
SUPABASE_SECRET_KEY=replace-with-secret-key

# Public origin of this app, used to build invitation links.
APP_URL=http://localhost:3000
